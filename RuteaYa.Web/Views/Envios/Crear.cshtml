@using RuteaYa.Entidades.Enums
@model RuteaYa.Logica.Dtos.Envios.CrearEnvioDto

@{
    ViewData["Title"] = "Publicar un nuevo envío";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="card-title mb-0 fw-bold">Publicar Envío</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Origen" class="form-label fw-semibold">Origen</label>
                                <input asp-for="Origen" class="form-control" placeholder="Ej: Morón" />
                                <span asp-validation-for="Origen" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Destino" class="form-label fw-semibold">Destino</label>
                                <input asp-for="Destino" class="form-control" placeholder="Ej: Ituzaingó" />
                                <span asp-validation-for="Destino" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Fecha" class="form-label fw-semibold">Fecha estimada</label>
                                <input asp-for="Fecha" type="date" class="form-control" />
                                <span asp-validation-for="Fecha" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Tamano" class="form-label fw-semibold">Tamaño del paquete</label>
                                <select asp-for="Tamano" class="form-select" asp-items="Html.GetEnumSelectList<TamanoPaquete>()">
                                    <option value="">-- Seleccionar tamaño --</option>
                                </select>
                                <span asp-validation-for="Tamano" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PesoKg" class="form-label fw-semibold">Peso (kg)</label>
                                <input asp-for="PesoKg" type="number" step="0.01" class="form-control" placeholder="Ej: 2.5" />
                                <span asp-validation-for="PesoKg" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MontoOfrecido" class="form-label fw-semibold">Monto ofrecido ($)</label>
                                <input asp-for="MontoOfrecido" type="number" step="0.01" class="form-control" placeholder="Ej: 3500" />
                                <span asp-validation-for="MontoOfrecido" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                                <textarea asp-for="Descripcion" rows="3" class="form-control" placeholder="Detalles del paquete, fragilidad o instrucciones"></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">Publicar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
