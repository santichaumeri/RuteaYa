@model RuteaYa.Web.Models.Historial.HistorialResumenViewModel
@{
    ViewData["Title"] = "Historial";
    var filtro = ViewData["Filtro"] as RuteaYa.Web.Models.Historial.HistorialFiltroViewModel
        ?? new();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="mb-4">
            <h1 class="h3 mb-1">Historial</h1>
            <p class="text-muted mb-0">Operaciones anteriores.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger"></div>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted">Viajes realizados</div><div class="display-6 fw-bold">@Model.ViajesRealizados</div></div></div></div>
            <div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted">Envíos transportados</div><div class="display-6 fw-bold">@Model.EnviosTransportados</div></div></div></div>
            <div class="col-md-4"><div class="card h-100 border-success bg-success-subtle"><div class="card-body"><div class="text-success">Ganancia efectiva</div><div class="display-6 fw-bold text-success">@Model.GananciaEfectiva.ToString("C0")</div></div></div></div>
        </div>

        <form method="get" class="card card-body mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-3"><label for="Desde" class="form-label">Desde</label><input id="Desde" name="Desde" value="@filtro.Desde?.ToString("yyyy-MM-dd")" class="form-control" type="date" /></div>
                <div class="col-md-3"><label for="Hasta" class="form-label">Hasta</label><input id="Hasta" name="Hasta" value="@filtro.Hasta?.ToString("yyyy-MM-dd")" class="form-control" type="date" /></div>
                <div class="col-md-3"><label for="Estado" class="form-label">Estado</label><select id="Estado" name="Estado" class="form-select"><option value="">Todos</option>@foreach (var estado in Enum.GetValues<EstadoEnvio>()) { <option value="@estado" selected="@(filtro.Estado == estado)">@estado</option> }</select></div>
                <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">Filtrar</button></div>
            </div>
        </form>

        <div class="card shadow-sm border-0">
            <div class="list-group list-group-flush">
            @if (Model.Operaciones.Count == 0)
            {
                <div class="list-group-item text-muted">No hay operaciones para los filtros seleccionados.</div>
            }
            else
            {
                foreach (var operacion in Model.Operaciones)
                {
                    <a asp-action="Detalle" asp-route-id="@operacion.ViajeId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div><strong>@operacion.Ruta</strong><div class="small text-muted">@operacion.Periodo.ToString("MMMM", new System.Globalization.CultureInfo("es-AR")) · @operacion.CantidadPaquetes paquetes · @operacion.Estado</div></div>
                        <strong>@operacion.Monto.ToString("C0")</strong>
                    </a>
                }
            }
            </div>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="mt-3"><ul class="pagination">
                @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                {
                    <li class="page-item @(pagina == Model.PaginaActual ? "active" : "")"><a class="page-link" asp-route-Pagina="@pagina" asp-route-Desde="@filtro.Desde" asp-route-Hasta="@filtro.Hasta" asp-route-Estado="@filtro.Estado">@pagina</a></li>
                }
            </ul></nav>
        }
    </div>
</div>
