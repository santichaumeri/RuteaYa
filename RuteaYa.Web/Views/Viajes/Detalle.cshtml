@model ViajeDetalleViewModel
@{
    ViewData["Title"] = "Detalle del viaje";
    var dias = new[]
    {
        (1, "Lunes"),
        (2, "Martes"),
        (4, "Miércoles"),
        (8, "Jueves"),
        (16, "Viernes"),
        (32, "Sábado"),
        (64, "Domingo")
    };
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 mb-1">Detalle del viaje</h1>
                <p class="text-muted mb-0">Información del recorrido y su configuración.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Oportunidades" asp-action="Index" asp-route-viajeId="@Model.Id" class="btn btn-success">Buscar oportunidades</a>
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                @if (Model.Estado == (int)EstadoViaje.Activo)
                {
                    <form asp-action="Desactivar" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('¿Seguro que querés desactivar este viaje? Ya no va a buscar oportunidades.');">
                        <button type="submit" class="btn btn-outline-danger">Desactivar</button>
                    </form>
                }
                <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>

        @if (TempData["MensajeViaje"] is string mensaje)
        {
            <div class="alert alert-success">@mensaje</div>
        }

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Recorrido</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Origen</dt>
                    <dd class="col-sm-8">@Model.Origen</dd>
                    <dt class="col-sm-4">Destino</dt>
                    <dd class="col-sm-8">@Model.Destino</dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Estado == (int)EstadoViaje.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Ruta y mapa</h2>
                <partial name="_RutaViaje" model="Model.Ruta" />
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Días y horarios</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Días</dt>
                    <dd class="col-sm-8">
                        @string.Join(", ", dias.Where(dia => (Model.DiasSemana & dia.Item1) == dia.Item1).Select(dia => dia.Item2))
                    </dd>
                    <dt class="col-sm-4">Hora de salida</dt>
                    <dd class="col-sm-8">@Model.HoraSalida.ToString(@"hh\:mm")</dd>
                    <dt class="col-sm-4">Hora de llegada</dt>
                    <dd class="col-sm-8">@Model.HoraLlegada.ToString(@"hh\:mm")</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Capacidad y desvío</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Máximo de paquetes</dt>
                    <dd class="col-sm-8">@Model.MaxPaquetes</dd>
                    <dt class="col-sm-4">Peso máximo</dt>
                    <dd class="col-sm-8">@Model.PesoMaximoKg.ToString("0.##") kg</dd>
                    <dt class="col-sm-4">Desvío máximo</dt>
                    <dd class="col-sm-8">@Model.DesvioMaximoKm.ToString("0.##") km</dd>
                    <dt class="col-sm-4">Paquetes asignados</dt>
                    <dd class="col-sm-8">@Model.CantidadPaquetesAsignados</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Paradas intermedias</h2>
                @if (Model.Paradas.Count == 0)
                {
                    <p class="text-muted mb-0">Este viaje no tiene paradas intermedias.</p>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var parada in Model.Paradas.OrderBy(parada => parada.Orden))
                        {
                            <li>@parada.Direccion</li>
                        }
                    </ol>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4" id="paquetes-asignados">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <h2 class="h5 mb-0">Paquetes asignados (@Model.PaquetesAsignados.Count)</h2>
                    <a asp-controller="Transportes" asp-action="Index" class="btn btn-sm btn-outline-primary">Ir a Mis transportes</a>
                </div>
                @if (Model.PaquetesAsignados.Count == 0)
                {
                    <p class="text-muted mb-0">Todavía no aceptaste paquetes para este viaje.</p>
                }
                else
                {
                    <div class="table-responsive paquetes-asignados">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Paquete</th>
                                    <th>Origen → Destino</th>
                                    <th class="text-end">Peso</th>
                                    <th>Estado</th>
                                    <th class="text-end">Ganancia</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var paquete in Model.PaquetesAsignados)
                                {
                                    <tr>
                                        <td>@paquete.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@paquete.Descripcion</td>
                                        <td>@paquete.Origen → @paquete.Destino</td>
                                        <td class="text-end">@paquete.PesoKg.ToString("0.##") kg</td>
                                        <td><partial name="~/Views/Transportes/_EstadoBadge.cshtml" model="paquete.Estado" /></td>
                                        <td class="text-end">$@paquete.Ganancia.ToString("N0")</td>
                                        <td class="text-end">
                                            <a asp-controller="Transportes" asp-action="Detalle" asp-route-id="@paquete.AsignacionId" class="btn btn-sm btn-outline-secondary">Ver</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
