@model IReadOnlyList<RuteaYa.Web.Models.Transportes.TransporteViewModel>

@{
    ViewData["Title"] = "Mis transportes";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">Mis transportes</h2>
        <p class="text-muted mb-0">Actualizá el avance de los paquetes que aceptaste llevar</p>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Viaje</th>
                        <th>Paquete</th>
                        <th>Origen / Destino</th>
                        <th>Estado</th>
                        <th>Ganancia</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                Todavía no aceptaste ningún paquete para transportar.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td>
                                    <strong>#@t.ViajeId</strong>
                                    <div class="text-muted small">@t.ViajeOrigen → @t.ViajeDestino</div>
                                </td>
                                <td>
                                    <strong>#@t.EnvioId</strong>
                                    <div class="text-muted small">@t.Descripcion (@t.PesoKg kg)</div>
                                </td>
                                <td>
                                    <strong>@t.Origen</strong>
                                    <div class="text-muted small">hacia @t.Destino</div>
                                </td>
                                <td><partial name="_EstadoBadge" model="t.Estado" /></td>
                                <td class="fw-bold text-success">$@t.Ganancia.ToString("N2")</td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap gap-1 justify-content-end">
                                        @if (t.PuedeMarcarRetirado)
                                        {
                                            <form asp-action="Retirar" asp-route-id="@t.AsignacionId" method="post">
                                                <button type="submit" class="btn btn-sm btn-primary">Marcar retirado</button>
                                            </form>
                                        }
                                        @if (t.PuedeMarcarEnCamino)
                                        {
                                            <form asp-action="EnCamino" asp-route-id="@t.AsignacionId" method="post">
                                                <button type="submit" class="btn btn-sm btn-primary">Marcar en camino</button>
                                            </form>
                                        }
                                        @if (t.PuedeMarcarEntregado)
                                        {
                                            <form asp-action="Entregar" asp-route-id="@t.AsignacionId" method="post">
                                                <button type="submit" class="btn btn-sm btn-success">Marcar entregado</button>
                                            </form>
                                        }
                                        <a asp-controller="Viajes" asp-action="Detalle" asp-route-id="@t.ViajeId"
                                           class="btn btn-sm btn-outline-secondary">Ver viaje</a>
                                        <a asp-action="Detalle" asp-route-id="@t.AsignacionId"
                                           class="btn btn-sm btn-outline-secondary">Ver envío</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
